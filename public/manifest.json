{
  "manifest_version": 3,
  "name": "Modern Tabs Outliner",
  "version": "1.0.6",
  "description": "A modern tabs outliner for Chrome and Edge.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "tabs",
    "windows",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Tabs Outliner",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "img/favicon.png",
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon128.png",
        "favicon.svg"
      ],
      "matches": [
        "<all_urls>",
        "chrome-extension://*/*"
      ]
    }
  ]
}
